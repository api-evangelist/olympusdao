                  "key": "start",
                  "value": "<date>",
                  "description": "(Required) Inclusive UTC calendar start date (YYYY-MM-DD)."
                },
                {
                  "disabled": false,
                  "key": "end",
                  "value": "<date>",
                  "description": "Inclusive UTC calendar end date (YYYY-MM-DD). Defaults to the latest published date."
